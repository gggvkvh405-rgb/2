{
  "appId": "id.byazen.messenger",
  "appName": "ByAzen",
  "webDir": "app",
  "bundledWebRuntime": false,
  "android": {
    "backgroundColor": "#060709",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "backgroundColor": "#060709",
      "showSpinner": false,
      "launchAutoHide": true,
      "launchShowDuration": 700
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#060709",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "body"
    }
  }
}
